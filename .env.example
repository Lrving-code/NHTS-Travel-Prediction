# Copy to .env locally if needed. Do not commit real secrets.

# Byte internal ModelHub route for LLM event-feature generation.
MODELHUB_API_KEY=
MODELHUB_BASE_URL=
MODELHUB_MODEL=gpt5.5

# Set after confirming the internal API surface.
# Supported planned values: openai_responses, openai_chat, custom_http
MODELHUB_API_STYLE=openai_chat

# Default auth convention. Adjust only if ModelHub requires a different header.
MODELHUB_AUTH_HEADER=Authorization
MODELHUB_AUTH_SCHEME=Bearer

# Local Cursor/CursorCC route. Prefer this only when the local router is running.
CURSOR_API_BASE_URL=http://127.0.0.1:3008/v1/chat/completions
CURSOR_API_AUTH_TOKEN=
CURSOR_API_MODEL=gpt-5.5-low
